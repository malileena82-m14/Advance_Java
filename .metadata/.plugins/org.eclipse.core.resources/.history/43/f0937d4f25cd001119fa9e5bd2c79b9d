/*Assignment 3: Delete an Employee
Table: employees
Description: Delete an employee using their employee ID.
Expected behavior:
Accept an employee ID as input.
Delete the corresponding employee using PreparedStatement.
Display whether a record was deleted.
Consider foreign key relationships with employee_projects before deleting an employee.
*/

package org.jdbcs;
import java.sql.*;
import java.util.*;
public class Q3DeleteEmployee {

	public static void main(String[] args) throws Exception
	{
		com.mysql.cj.jdbc.Driver d = new com.mysql.cj.jdbc.Driver();
		DriverManager.registerDriver(d);
		Connection conn = DriverManager.getConnection("jdbc:mysql://localHost:3306/march26","root","14062004");
		if(conn!=null)
		{
			System.out.println("Database is created");
			System.out.println("Delete Employee Data");
			Scanner xyz = new Scanner(System.in);
			System.out.println("Enter Id");
			int id = xyz.nextInt();
			
			Statement s = conn.createStatement();
			int value = s.executeUpdate("delete from employees where eid = "+id+"");
			
			if(value>0)
			{
				System.out.println("Record delete Successfully");
			}
			else
			{
				System.out.println("Record not delete");
			}
		}
		else
		{
			System.out.println("Database not created");
		}
	
	}

}
